# Used for package search/autocomplete, via Algolia's `npm-search` index
# (https://github.com/algolia/npm-search). Access to the public index is
# gated behind an Algolia support request, see the npm-search README.
#
# These are searched directly from the browser, so must be `NEXT_PUBLIC_`.
# The API key should be a search-only key, safe to expose client-side.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=
